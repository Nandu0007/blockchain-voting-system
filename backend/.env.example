// Backend environment variables template
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/voting_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=voting_user
DB_PASSWORD=your_password
DB_NAME=voting_db

# Blockchain Configuration
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY
PRIVATE_KEY=your_private_key_here

# Contract Addresses
VOTING_REGISTRY_CONTRACT=0x...
ADVANCED_BALLOT_CONTRACT=0x...
VOTER_REGISTRY_CONTRACT=0x...
VOTE_DELEGATION_CONTRACT=0x...
MULTISIG_VOTING_CONTRACT=0x...

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# API Configuration
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
API_VERSION=v1

# Logging
LOG_LEVEL=info

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Web3 Configuration
WEB3_PROVIDER_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
NETWORK_ID=11155111
CHAIN_ID=11155111
